# Optional capture-module configuration. Environment variables take precedence.
# The module reads this file after it is copied to the repository-root .env.
XCRAPE_WORKERS=1
XCRAPE_QUEUE_SIZE=20
XCRAPE_TIMEOUT=60

# Optional explicit capture SQLite file path, relative to the launch directory.
# LOCALGHOST_CAPTURE_DB_PATH=C:/data/captures.db

# Legacy SQLite URL; ignored when LOCALGHOST_CAPTURE_DB_PATH is set.
# Relative URL paths start at the inner project directory in a source checkout.
# DATABASE_URL=sqlite:///data/captures.db

# Port used only by the compatibility xcrape command.
PORT=8000
